{
    "name": "janborg/contao-h4a_gamestats",
    "description": "Spielberichte von handball4all in Contao CMS integrieren",
    "keywords": [
        "Handball",
        "H4a",
        "Ergebnisse",
        "Statistik",
        "Torschützen"
    ],
    "type": "contao-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Jan Lünborg",
            "homepage": "https://github.com/janborg"
        }
    ],
    "require": {
        "php": "^8.3",
        "contao/core-bundle": "^5.3",
        "contao/calendar-bundle": "^5.3",
        "doctrine/dbal": "^3.6",
        "janborg/contao-h4a_tabellen": "^4.0",
        "psr/log": "^1.1 || 2.0 || ^3.0",
        "symfony/config": "^6.0 || ^7.0",
        "symfony/console": "^6.0 || ^7.0",
        "symfony/dependency-injection": "^6.0 || ^7.0",
        "symfony/dom-crawler": "^6.0 || ^7.0",
        "symfony/http-foundation": "^6.0 || ^7.0",
        "symfony/http-kernel": "^6.0 || ^7.0",
        "symfony/process": "^6.0 || ^7.0",
        "symfony/filesystem": "^6.0 || ^7.0",
        "symfony/http-client": "^6.0 || ^7.0",
        "symfony/event-dispatcher": "^6.0 || ^7.0"
    },
    "require-dev": {
        "contao/easy-coding-standard": "^6.13",
        "contao/manager-plugin": "^2.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^10.0.16",
        "bamarni/composer-bin-plugin": "^1.5",
        "symfony/phpunit-bridge": "^8.0",
        "shipmonk/composer-dependency-analyser": "^1.7",
        "symplify/easy-coding-standard": "13.2.3"
    },
    "conflict": {
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "autoload": {
        "psr-4": {
            "Janborg\\H4aGamestats\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Janborg\\H4aGamestats\\Tests\\": "tests/"
        }
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": false,
            "target-directory": "tools"
        },
        "contao-manager-plugin": "Janborg\\H4aGamestats\\ContaoManager\\Plugin"
    },
    "support": {
        "issues": "https://github.com/janborg/contao-h4a_gamestats/issues",
        "source": "https://github.com/janborg/contao-h4a_gamestats"
    },
    "config": {
        "allow-plugins": {
            "contao-components/installer": true,
            "contao/manager-plugin": true,
            "contao-community-alliance/composer-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "bamarni/composer-bin-plugin": true,
            "php-http/discovery": true,
            "terminal42/contao-build-tools": true
        }
    },
    "scripts": {
        "all": [
            "@depcheck",
            "@ecs",
            "@phpstan",
            "@unit-tests"
        ],
        "depcheck": "@php vendor/bin/composer-dependency-analyser --config=depcheck.php",
        "ecs": "@php vendor/bin/ecs check src tests --config ecs.php --fix --ansi",
        "phpstan": "@php vendor/bin/phpstan analyze --configuration phpstan.neon --no-progress --ansi",
        "unit-tests": "@php vendor/bin/phpunit --colors=always"
    }
}
